{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtm-signal-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Kill switches — three levels (configuration tier 1)
    "PIPELINE_ENABLED": "true",
    "AI_SCORING_ENABLED": "false",
    "DRY_RUN": "false",
    // Reaper TTL — minutes before an in_flight claim is considered stale
    "CLAIM_TTL_MINUTES": "5"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtm-signal-pipeline",
      "database_id": "placeholder-set-on-deploy"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SIGNALS",
        "queue": "gtm-signals"
      }
    ],
    "consumers": [
      {
        "queue": "gtm-signals",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "gtm-signals-dlq"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
