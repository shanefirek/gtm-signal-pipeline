{
  "name": "gtm-signal-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Signal-driven GTM pipeline on Cloudflare Workers + D1 + Queues. Inbox-first ingest, atomic claims, reapers, kill switches.",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 execute gtm-signal-pipeline --local --file=schema.sql",
    "db:remote": "wrangler d1 execute gtm-signal-pipeline --remote --file=schema.sql",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
